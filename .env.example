# Spotify API Credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# MySQL database (saved sessions, cluster progress, analytics) — used when DEV_MODE=1;
# with DEV_MODE=0 set DATABASE_URL instead
DB_HOST=localhost
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=spotify_analytics

# Set to 1 for local development (DB_* vars, Spotify OAuth export in the sidebar,
# auto-load of data/dev_collection.json, no analytics)
DEV_MODE=0
