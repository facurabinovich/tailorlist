# Spotify API Credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# MySQL database (only needed for "Facu's Collection" mode)
DB_HOST=localhost
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=spotify_analytics

# Set to 1 to enable dev features (ETL on startup, OAuth export, dev_collection.json)
DEV_MODE=0
